{
  "info": {
    "_postman_id": "pokedex-api-shift-c-2026",
    "name": "PokéDex Explorer API Collection",
    "description": "Koleksi endpoint PokéAPI v2 untuk pengujian respon JSON, validasi struktur data model, dan integrasi Retrofit 2 pada aplikasi Android PokéDex Explorer (Shift C Responsi Mobile).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://pokeapi.co/api/v2",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. GET List 151 Pokémon (Katalog Generasi 1)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pokemon?limit=151&offset=0",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pokemon"
          ],
          "query": [
            {
              "key": "limit",
              "value": "151",
              "description": "Batas jumlah Pokémon (151 Kanto)"
            },
            {
              "key": "offset",
              "value": "0",
              "description": "Offset data awal"
            }
          ]
        },
        "description": "Mengambil daftar ringkas 151 Pokémon pertama untuk mengisi grid katalog di HomeScreen."
      },
      "response": []
    },
    {
      "name": "2. GET Detail Charizard (#006)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pokemon/6",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pokemon",
            "6"
          ]
        },
        "description": "Mengambil rincian lengkap Charizard: tipe elemen (Fire, Flying), status fisik (berat, tinggi), abilities, dan 6 statistik dasar (HP, ATK, DEF, SP.ATK, SP.DEF, SPD)."
      },
      "response": []
    },
    {
